# Copy this file to .env and fill in your key. .env is gitignored.
#   cp .env.example .env
#
# Get a key at https://console.x.ai — new accounts receive promotional credits, and
# processing all 20 sample invoices costs well under a dollar on grok-4-1-fast.

XAI_API_KEY=

# --- optional: everything below has a working default ---

# Model used for extraction, approval and the critic.
XAI_MODEL=grok-4-1-fast

# Above this total, an invoice takes the scrutiny path regardless of how clean it looks.
# Denominated in HOME_CURRENCY.
SCRUTINY_THRESHOLD=10000

# The currency we can actually pay. An invoice in anything else is routed to a person,
# because there is no exchange rate source here and inventing one would put a fabricated
# number into a payments record.
HOME_CURRENCY=USD

# How far above the agreed catalogue price a line may be billed before it is flagged. A premium
# for a rush or a short run is legitimate; this catches a price unrelated to what was agreed.
PRICE_TOLERANCE=0.10

# Attempts at reading one document: one cold, one carrying the specific complaint about what
# did not check out. A third would put the same complaint to the same model at the same
# temperature, so an extraction that still cannot be traced goes to a person instead.
MAX_EXTRACTION_ATTEMPTS=2

# How many times the critic may send the approval agent back before the invoice is escalated.
CRITIQUE_MAX_ROUNDS=2

# How many rounds of lookups the critic may make before it has to write its critique.
CRITIC_MAX_TOOL_STEPS=4
