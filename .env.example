# Copy this file to .env and fill in your own key. .env is gitignored.
#   cp .env.example .env
#
# Get a key at https://console.x.ai — new accounts receive promotional credits,
# and this project costs well under a dollar to run on grok-4-1-fast.

XAI_API_KEY=

# Model to use. Cheap one for development, flagship for final runs.
XAI_MODEL=grok-4-1-fast

# Retry limit for the extraction self-correction loop.
MAX_EXTRACTION_RETRIES=3
